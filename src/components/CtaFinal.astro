---
import BotonWhatsApp from './BotonWhatsApp.astro';
import BotonLlamar from './BotonLlamar.astro';
import { contacto } from '../config/site';

interface Props {
  titulo: string;
  texto: string;
  mensajeWA: string;
}
const { titulo, texto, mensajeWA } = Astro.props;
---
<section class="relative overflow-hidden bg-carbon py-16 sm:py-24" aria-labelledby="titulo-cta-final">
  <div class="rejilla absolute inset-0" aria-hidden="true"></div>
  <div class="relative contenedor grid items-end gap-8 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <p class="antetitulo text-rojo-claro"><span class="chevrones" aria-hidden="true">&gt;&gt;</span> Hablemos</p>
      <h2 id="titulo-cta-final" class="titulo-display mt-3 text-5xl sm:text-6xl lg:text-7xl">{titulo}</h2>
      <p class="mt-5 max-w-2xl text-lg text-acero-200">{texto}</p>
    </div>
    <div class="flex flex-col gap-3">
      <BotonWhatsApp mensaje={mensajeWA} origen="cta-final" clase="w-full" />
      <BotonLlamar origen="cta-final" clase="w-full" />
      <p class="text-center font-mono text-sm text-acero-300">WhatsApp y llamadas: {contacto.telefonoVisibleIntl}</p>
    </div>
  </div>
</section>
