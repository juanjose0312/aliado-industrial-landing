---
/** Íconos SVG de línea (sin emojis). Decorativos: aria-hidden. */
interface Props {
  nombre: 'whatsapp' | 'telefono' | 'correo' | 'flecha' | 'facebook' | 'ubicacion' | 'cerrar' | 'anterior' | 'siguiente' | 'check' | 'camara' | 'alerta' | 'mas';
  clase?: string;
}
const { nombre, clase = 'size-5' } = Astro.props;
---
<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nombre === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.6z" />
      <path d="M9 8.6c.2-.5.6-.6 1-.6.3 0 .5 0 .7.5l.6 1.5c.1.3 0 .6-.2.8l-.5.6c.6 1.2 1.6 2.2 2.9 2.9l.6-.5c.2-.2.5-.3.8-.2l1.5.6c.4.2.5.4.5.7 0 .5-.2.9-.6 1.1-.6.4-1.4.6-2.4.3-2.3-.7-4.4-2.8-5.1-5.1-.2-.9 0-1.7.2-2.2z" fill="currentColor" stroke="none" />
    </>
  )}
  {nombre === 'telefono' && <path d="M5 4h3.5l1.5 4.5-2.25 1.5a11 11 0 0 0 6.25 6.25L15.5 14l4.5 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
  {nombre === 'correo' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="M3.5 6l8.5 7 8.5-7" />
    </>
  )}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nombre === 'facebook' && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8z" />}
  {nombre === 'ubicacion' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nombre === 'anterior' && <path d="M15 5l-7 7 7 7" />}
  {nombre === 'siguiente' && <path d="M9 5l7 7-7 7" />}
  {nombre === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {nombre === 'camara' && (
    <>
      <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
      <circle cx="12" cy="13" r="3.5" />
    </>
  )}
  {nombre === 'alerta' && (
    <>
      <path d="M12 3l9.5 17h-19z" />
      <path d="M12 10v4.5M12 17.5v.01" />
    </>
  )}
  {nombre === 'mas' && <path d="M12 5v14M5 12h14" />}
</svg>
