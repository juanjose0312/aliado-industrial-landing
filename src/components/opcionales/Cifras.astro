---
/** Cifras verificables (equipos fabricados, etc.). Vacío = no se muestra. */
import { opcionales } from '../../config/site';
const lista = opcionales.cifras;
---
{lista.length > 0 && (
  <section class="bg-acero-900 py-12" aria-label="Cifras">
    <dl class="contenedor grid grid-cols-2 gap-6 lg:grid-cols-4">
      {lista.map((c) => (
        <div class="flex flex-col-reverse">
          <dt class="text-acero-300">{c.etiqueta}</dt>
          <dd class="font-display text-5xl font-extrabold">{c.valor}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
