---
/** Vacuómetro decorativo (sin cifras técnicas). La aguja barre una vez al cargar. */
interface Props {
  clase?: string;
  tono?: 'claro' | 'oscuro';
}
const { clase = 'size-40', tono = 'claro' } = Astro.props;
const inicio = -225;
const marcas = Array.from({ length: 28 }, (_, i) => {
  const angulo = ((inicio + (i * 270) / 27) * Math.PI) / 180;
  const larga = i % 3 === 0;
  const r1 = larga ? 70 : 75;
  return {
    x1: 100 + r1 * Math.cos(angulo),
    y1: 100 + r1 * Math.sin(angulo),
    x2: 100 + 82 * Math.cos(angulo),
    y2: 100 + 82 * Math.sin(angulo),
    larga,
  };
});
const tinta = tono === 'claro' ? '#15171a' : '#f3f4f5';
const fondo = tono === 'claro' ? '#f6f7f8' : '#1a1d21';
---
<svg class:list={['vacuometro', clase]} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <circle cx="100" cy="100" r="96" fill="#9aa2ab" />
  <circle cx="100" cy="100" r="90" fill="#5d646c" />
  <circle cx="100" cy="100" r="86" fill={fondo} />
  <path d="M179.2 78.8 A82 82 0 0 1 158 158" fill="none" stroke="#ee1922" stroke-width="7" />
  {marcas.map((m) => (
    <line x1={m.x1.toFixed(1)} y1={m.y1.toFixed(1)} x2={m.x2.toFixed(1)} y2={m.y2.toFixed(1)} stroke={tinta} stroke-width={m.larga ? 2.6 : 1.3} />
  ))}
  <text x="100" y="138" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="2" fill={tinta}>VACÍO</text>
  <g class="vacuometro-aguja" style="transform-origin: 100px 100px">
    <line x1="100" y1="100" x2="100" y2="30" stroke="#ee1922" stroke-width="3.5" stroke-linecap="round" />
    <line x1="100" y1="100" x2="100" y2="116" stroke="#ee1922" stroke-width="5" stroke-linecap="round" />
  </g>
  <circle cx="100" cy="100" r="8" fill="#2a2f35" />
  <circle cx="100" cy="100" r="3" fill="#9aa2ab" />
</svg>

<style>
  .vacuometro-aguja {
    transform: rotate(58deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .vacuometro-aguja {
      animation: barrido 1.6s cubic-bezier(0.3, 1.4, 0.5, 1) 0.4s both;
    }
  }
  @keyframes barrido {
    from {
      transform: rotate(-135deg);
    }
    to {
      transform: rotate(58deg);
    }
  }
</style>
