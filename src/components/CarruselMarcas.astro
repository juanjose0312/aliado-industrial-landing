---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { marcasBombas } from '../config/site';

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/marcas/*.{svg,png}', { eager: true });
const logos = new Map(
  Object.entries(archivos).map(([ruta, mod]) => [ruta.split('/').pop()!.replace(/\.\w+$/, ''), mod.default]),
);

const slug = (nombre: string) =>
  nombre
    .split(' (')[0]
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/\s+/g, '-');

const marcas = marcasBombas.map((nombre) => ({ nombre, logo: logos.get(slug(nombre)) }));
---
<div class="carrusel-marcas">
  {[false, true].map((copia) => (
    <ul class="pista" aria-hidden={copia ? 'true' : undefined} aria-label={copia ? undefined : 'Marcas de bombas'}>
      {marcas.map(({ nombre, logo }) => (
        <li class="marca">
          {logo ? (
            <Image src={logo} alt={copia ? '' : nombre} height={96} class="logo" loading="lazy" />
          ) : (
            <span class="font-mono text-lg font-semibold sm:text-xl">{nombre.split(' (')[0]}</span>
          )}
        </li>
      ))}
    </ul>
  ))}
</div>

<style>
  .carrusel-marcas {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .pista {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    animation: desplazar 45s linear infinite;
  }
  .carrusel-marcas:hover .pista,
  .carrusel-marcas:focus-within .pista {
    animation-play-state: paused;
  }
  .marca {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7rem;
    height: 2.5rem;
    margin-inline: 1rem;
    color: var(--color-tinta);
    opacity: 0.55;
  }
  @media (min-width: 640px) {
    .marca {
      width: 10rem;
      height: 3.25rem;
      margin-inline: 1.5rem;
    }
  }
  .logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0);
  }
  @keyframes desplazar {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carrusel-marcas {
      mask-image: none;
    }
    .pista {
      flex-wrap: wrap;
      flex-shrink: 1;
      justify-content: center;
      row-gap: 1.5rem;
      animation: none;
    }
    .pista[aria-hidden] {
      display: none;
    }
  }
</style>
