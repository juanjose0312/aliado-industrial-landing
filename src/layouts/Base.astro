---
import '../styles/global.css';
import fuenteTitulos from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraContactoMovil from '../components/BarraContactoMovil.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, ads } from '../config/site';

interface Props {
  titulo: string;
  descripcion: string;
  pagina: 'equipos' | 'bombas' | 'otra';
  /** Mensaje de WhatsApp para header, barra móvil y botón flotante */
  mensajeWA: string;
  /** Ruta de la imagen Open Graph (1200×630) dentro de /public */
  og?: string;
  noindex?: boolean;
}

const { titulo, descripcion, pagina, mensajeWA, og = '/og/equipos.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, ''), site.url).href;
const imagenOg = new URL(og, site.url).href;
const produccion = import.meta.env.PROD;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#111315" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fuenteTitulos} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.razonSocial} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <JsonLd />

    {
      produccion && (
        <script is:inline define:vars={{ id: ads.id }}>
          // Etiqueta de Google Ads. La cola (dataLayer) existe desde el inicio, así que las
          // conversiones nunca se pierden; gtag.js se descarga de forma asíncrona tras la primera
          // interacción o unos segundos después de cargar, para no frenar la página.
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', id);
          var cargado = false;
          function cargarGtag() {
            if (cargado) return;
            cargado = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
          }
          ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (e) {
            addEventListener(e, cargarGtag, { once: true, passive: true });
          });
          addEventListener('load', function () {
            setTimeout(cargarGtag, 3000);
          });
        </script>
      )
    }
  </head>
  <body class="min-h-dvh">
    <Header actual={pagina} mensajeWA={mensajeWA} />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <BarraContactoMovil mensajeWA={mensajeWA} />
    <WhatsAppFlotante mensajeWA={mensajeWA} />

    <script>
      import { iniciarTracking } from '../scripts/tracking';
      import { capturarAtribucion } from '../scripts/atribucion';
      iniciarTracking();
      capturarAtribucion();
    </script>
  </body>
</html>
